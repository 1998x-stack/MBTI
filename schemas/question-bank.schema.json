{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonaQuest Question Bank v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bankId",
    "bankVersion",
    "scoringVersion",
    "locale",
    "metadata",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "bankId": {
      "const": "personaquest-short-zhcn"
    },
    "bankVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scoringVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locale": {
      "const": "zh-CN"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intendedUse",
        "validationStatus",
        "description",
        "licenseStatus"
      ],
      "properties": {
        "intendedUse": {
          "const": "self-exploration"
        },
        "validationStatus": {
          "enum": [
            "unvalidated",
            "under-review"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "licenseStatus": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "axis",
        "title",
        "scenario",
        "prompt",
        "options",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[0-9]{2,3}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "axis": {
          "enum": [
            "EI",
            "SN",
            "TF",
            "JP"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "scenario": {
          "type": "string",
          "minLength": 5
        },
        "prompt": {
          "type": "string",
          "minLength": 4
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "licenseStatus",
            "reviewed"
          ],
          "properties": {
            "origin": {
              "enum": [
                "project-authored",
                "licensed"
              ]
            },
            "licenseStatus": {
              "type": "string",
              "minLength": 3
            },
            "reviewed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "letter",
        "weight",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[0-9]{2,3}-[a-d]$"
        },
        "letter": {
          "enum": [
            "E",
            "I",
            "S",
            "N",
            "T",
            "F",
            "J",
            "P"
          ]
        },
        "weight": {
          "enum": [
            1,
            2
          ]
        },
        "label": {
          "type": "string",
          "minLength": 4,
          "maxLength": 180
        }
      }
    }
  }
}
